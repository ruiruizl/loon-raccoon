[Script]
raccoon-checkin = type=cron,cronexp="12 0 * * *",script-path=https://cdn.jsdelivr.net/gh/ruiruizl/loon-raccoon@main/raccoon-checkin.js,timeout=120,tag=小浣熊每日签到,argument=nation=86,phone=REPLACE_ME,password=REPLACE_ME

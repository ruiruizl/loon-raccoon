#!name = 小浣熊 OpenAI 反代
#!desc = 把商汤小浣熊（office-raccoon）包装成 OpenAI 兼容 API：手机号+密码自动登录、token 自动刷新，/v1/chat/completions 真流式透传，/v1/models 动态模型目录，附每日自动签到。移植自 LinkPass888 的 Surge 模块。
#!author = LinkPass888（原 Surge 版）· Loon 移植
#!homepage = https://github.com/LinkPass888/Surge
#!loon_version = 3.5.1(983)
#!system = iOS,iPadOS,macOS
#!date = 2026-10-28
#!tag = AI,工具
#!type = normal

[Argument]
nation = input,"86",type=string,tag=国家码,desc=手机号国家码，默认 86
phone = input,"none",type=string,tag=手机号,desc=小浣熊登录手机号；保留 none 表示不填
password = input,"none",type=string,tag=密码,desc=小浣熊登录密码（明文保存在插件参数中），保留 none 表示不填
token = input,"none",type=string,tag=Access Token,desc=可选：直接粘贴 access_token，填了就优先用它、不再登录；保留 none 表示不填
checkin = switch,true,tag=每日自动签到
checkin_cron = input,"12 0 * * *",type=string,tag=签到时间,desc=五段 Cron 表达式（分 时 日 月 周）

[Script]
request if ${url} ~= /^https?:\/\/xiaohuanxiong\.com\/v1\/(chat\/completions|models|checkin|probe)(\/|\?|$)/ then script("https://raw.githubusercontent.com/ruiruizl/loon-raccoon/main/raccoon-openai.js", {${nation}, ${phone}, ${password}, ${token}}) with requires_body=true, timeout=600, tag="小浣熊反代"

cron ${checkin_cron} then script("https://raw.githubusercontent.com/ruiruizl/loon-raccoon/main/raccoon-openai.js", {${nation}, ${phone}, ${password}, ${token}}) with enable=${checkin}, timeout=120, tag="小浣熊每日签到"

[Mitm]
hostname = xiaohuanxiong.com, *.xiaohuanxiong.com
